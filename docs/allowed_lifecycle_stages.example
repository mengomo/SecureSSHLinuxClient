# ──────────────────────────────────────────────────────────────────────────────
# /etc/ssh/allowed_lifecycle_stages
#
# 每台服务器根据自身角色配置允许的生命周期阶段。
# 每行一个 lc:<阶段名>，空行和 # 开头的注释会被忽略。
#
# CA 签发证书时嵌入的 lc:* principal 必须出现在此文件中，
# 否则 AuthorizedPrincipalsCommand 脚本会拒绝登录。
#
# 如果此文件不存在，脚本将允许所有阶段（向后兼容）。
# 如果此文件存在但为空，则拒绝所有证书登录。
# ──────────────────────────────────────────────────────────────────────────────

# ── 可用的生命周期阶段 ────────────────────────────────────────────────────────
# lc:development        — 开发阶段（终端 + 端口转发 + Agent 转发，12h TTL）
# lc:zf_production      — ZF 生产阶段（仅终端，4h TTL）
# lc:oem_production     — OEM 生产阶段（仅终端，4h TTL）
# lc:field_operation    — 现场运维（终端 + 端口转发，8h TTL，默认）
# lc:claims_warranty    — 索赔/保修（仅终端，2h TTL）
# lc:end_of_life        — 生命周期终止（仅终端，1h TTL）

# ── 示例：现场运维设备 ────────────────────────────────────────────────────────
lc:field_operation
lc:claims_warranty

# ── 示例：产线服务器（取消注释以启用）──────────────────────────────────────────
# lc:zf_production
# lc:oem_production

# ── 示例：开发服务器（取消注释以启用）──────────────────────────────────────────
# lc:development
# lc:field_operation
