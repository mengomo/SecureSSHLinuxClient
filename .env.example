APP_NAME=zfcssh-broker
APP_VERSION=0.2.0
HOST=0.0.0.0
PORT=8443
BROKER_PUBLIC_BASE_URL=https://broker.example.internal
LOG_LEVEL=INFO
AUDIT_LOG_PATH=/var/log/zfcssh-broker/audit.log
IDEMPOTENCY_DB_PATH=/var/lib/zfcssh-broker/idempotency.db
TEMP_DIR=/var/tmp/zfcssh-broker
USER_CA_PRIVATE_KEY=/root/.step/secrets/ssh_user_ca_key
USER_CA_PUBLIC_KEY=/root/.step/certs/ssh_user_ca_key.pub
USER_CA_KEY_PASSPHRASE=
HOST_CA_PRIVATE_KEY=/root/.step/secrets/ssh_host_ca_key
HOST_CA_PUBLIC_KEY=/root/.step/certs/ssh_host_ca_key.pub
HOST_CA_KEY_PASSPHRASE=
USER_ALLOWED_PRINCIPALS=rocky,root
USER_DEFAULT_TTL_HOURS=24
USER_MAX_TTL_HOURS=168
HOST_DEFAULT_TTL_HOURS=26280
HOST_MAX_TTL_HOURS=26280

# ── Lifecycle Diagnostic Role Tokens ──
# Each token grants a diagnostic role mapped to allowed lifecycle profiles.
# Role dev:     development, zf_production
# Role prod:    zf_production, oem_production, field_operation, end_of_life
# Role claims:  claims_warranty, field_operation
# Role OEMprod: oem_production, field_operation
# Startup validation rejects these placeholders until they are replaced.
TOKEN_DEV=change-me-dev-token
TOKEN_PROD=change-me-prod-token
TOKEN_CLAIMS=change-me-claims-token
TOKEN_OEMPROD=change-me-oemprod-token
TOKEN_SERVER=change-me-server-token
TOKEN_ADMIN=change-me-admin-token

# ── Extension Profile Defaults ──
DEFAULT_USER_PROFILE=field_operation
